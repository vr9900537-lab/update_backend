APP_NAME=Custody Band Monitoring API
APP_VERSION=0.1.0
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Firebase project ID provided for this deployment (not a credential).
FIREBASE_PROJECT_ID=update-custody-band-backend
# Use ADC or set one of the credential options below. Never commit credentials.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=
SIMULATED_INGESTION_ENABLED=false
DEVICE_ONLINE_TIMEOUT_SECONDS=300
OFFLINE_DEVICE_WORKER_ENABLED=false
OFFLINE_DEVICE_SCAN_INTERVAL_SECONDS=60
LOW_BATTERY_THRESHOLD=20
TRIP_IDLE_GAP_SECONDS=1800
TRIP_MIN_DISTANCE_METERS=100
NOTIFICATION_MODE=mock
